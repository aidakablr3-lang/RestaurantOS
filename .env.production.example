# RestaurantOS -- PRODUCTION environment template.
#
# For a fresh deploy, you don't need to hand-copy this file at all --
# scripts/deploy/02_generate_secrets.sh generates every value below (DB
# password, JWT keypair) on the box itself and writes
# /opt/restaurantos/.env directly. This file exists as a reference for
# what ends up in there and why, and for manually rotating a value later.
# If you do copy it by hand, chmod 600 the result immediately. Never
# commit the real file -- .gitignore already excludes .env / .env.*
# (except *.example).
#
# Every value below must be freshly generated for THIS deployment. Nothing
# here may be copied from services/api/.env.example, this repo's git
# history, or any dev/rehearsal environment -- see docs/DEPLOYMENT.md for
# the full step-by-step and the reasoning behind each value.
#
# Sourced from actual code (services/api/src/restaurant_os_api/core/config.py
# + docker-compose.prod.yml), not just prose.

# --- App ---
# Read by the API but does not currently gate any runtime behavior
# (confirmed: grepped the whole services/api/src tree, app_env is read once
# and never branched on). Set it anyway -- it's the documented convention
# and costs nothing.
APP_ENV=production

# --- Database ---
# DATABASE_USER / DATABASE_NAME: your choice, "restaurantos" is fine for a
# single-tenant-per-install-minded default even though the schema itself is
# multi-tenant (tenant_id + RLS) -- this is just the Postgres role/db name.
DATABASE_USER=restaurantos
DATABASE_NAME=restaurantos

# DATABASE_PASSWORD: generate fresh, do not reuse any password from
# anywhere else. docker-compose.prod.yml refuses to start without this set
# (uses Compose's ${VAR:?message} required-var syntax).
#   openssl rand -base64 32
DATABASE_PASSWORD=

# --- JWT (RS256) ---
# Generate a REAL keypair for this deployment. Never reuse the dev keypair
# in infrastructure/docker/dev-jwt/ or any keypair that has ever appeared in
# this repo's git history -- both are compromised by virtue of being public.
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste the FULL PEM content below (including the ----BEGIN/END---- lines,
# with real line breaks preserved) -- this must be the actual key material,
# not a file path; docker-compose.prod.yml passes it straight through as an
# environment variable. Delete the .pem files from disk after pasting them
# in here, or keep them somewhere at least as protected as this file.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Defaults are sane for production, override only if you have a specific
# reason (services/api/src/restaurant_os_api/core/config.py's own defaults):
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_ISSUER=restaurantos

# --- CORS ---
# The exact real origin admin-web is served from -- scheme + host, no
# trailing slash, no wildcard (nothing in services/api/src accepts "*").
# Must match exactly or guest QR ordering fails with a browser CORS error.
CORS_ALLOWED_ORIGINS=https://admin.prashanthai.com

# --- Frontend (admin-web) ---
# Read from THIS SAME file -- docker-compose.prod.yml passes it to
# admin-web as a Docker build ARG, not a separate apps/admin-web/.env.local
# file (that file is for local, non-Docker development only; this
# deployment containerizes admin-web -- see docs/DEPLOYMENT.md §1). Baked
# into the Next.js bundle at image *build* time, not read at container
# start -- changing it needs `docker compose up -d --build admin-web`, not
# just a restart.
NEXT_PUBLIC_API_BASE_URL=https://api.prashanthai.com

# infrastructure/docker/admin-web-prod/Dockerfile's builder stage refuses
# to build at all if this arg is empty (`test -n "$NEXT_PUBLIC_API_BASE_URL"`)
# -- src/lib/api-client.ts / src/lib/guest-api-client.ts otherwise fall
# back to http://localhost:8000 with no build error, silently shipping a
# broken production bundle. That failure mode is now caught at build
# time, not left as a manual checklist item.

# --- Reverse proxy (Caddy) ---
# Let's Encrypt uses this only for certificate expiry/problem notices --
# never published anywhere. Caddy substitutes it into
# infrastructure/reverse-proxy/Caddyfile via {$CADDY_ACME_EMAIL}.
CADDY_ACME_EMAIL=

# --- Off-host backup (S3) ---
# Read by scripts/deploy/backup.sh. The IAM user behind these keys must
# be write-only (s3:PutObject on this one bucket only -- no
# ListBucket/GetObject/DeleteObject, no other buckets) -- see
# docs/DEPLOYMENT.md's Backup section for the exact bucket setup, IAM
# policy JSON, and lifecycle rule. Never the same credential as your own
# AWS console/CLI login.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
