# Copy to .env and fill in real values for local (non-Docker) development.
# `docker compose up` does NOT use this file for JWT_PRIVATE_KEY/PUBLIC_KEY
# (see infrastructure/docker/dev-jwt/README.md) but does read DATABASE_*
# from it if present -- see docker-compose.yml.
#
# Full reference: docs/DEVELOPMENT.md. Naming matches Technical
# Architecture v2.0 §7.3's documented variable groups.

# --- App ---
APP_ENV=development

# --- Database ---
# Async SQLAlchemy URL. docker-compose.yml builds this for you from
# DATABASE_USER/PASSWORD/NAME below when running the API in a container;
# set DATABASE_URL directly instead if running the API outside Docker
# against your own Postgres instance.
DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos
DATABASE_USER=restaurantos
DATABASE_PASSWORD=restaurantos
DATABASE_NAME=restaurantos
# Host-side port docker-compose publishes Postgres on (container always
# listens on 5432 internally). Change if 5433 collides with something else
# already running on your machine.
DATABASE_HOST_PORT=5433

# --- JWT (RS256) ---
# Required, no default -- see docs/DEVELOPMENT.md for how to generate a
# throwaway local keypair. Must be the actual PEM content (with real line
# breaks), not a file path, when running the API outside Docker.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=restaurantos

# --- CORS ---
# Comma-separated browser origins allowed to call this API. Defaults to
# admin-web's local dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Anthropic (menu import) ---
# Required only for POST .../menu-imports/extract (Claude vision extraction
# of a photographed/scanned menu). Every other route works without it.
ANTHROPIC_API_KEY=

# --- Test-only ---
# Set to a real PostgreSQL instance (a *disposable* one -- the integration
# suite truncates every table between tests and runs migrations up/down
# around the whole session) to enable services/api/tests/integration/.
# Unset: those tests are skipped, not failed. See
# services/api/tests/integration/conftest.py.
# TEST_DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos_test
